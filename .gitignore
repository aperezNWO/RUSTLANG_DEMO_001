.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# Environment and sensitive data
.env
.env.*
!.env.example

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db